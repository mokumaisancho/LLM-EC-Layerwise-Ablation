{"protocol":"FUNCTION_BOUNDARY_S1_V1","status":"FROZEN_BEFORE_MODEL_RUN","dataset_digest":"4d15e1b89c6382a8a5252558525db55cccc700096ad5c92e97d384c9d59cd190","fixture_count":10,"metric_contract":{"fields":["primary_fact_id","semantic_concept_id","key_relation_id","ambiguity","goal_id"],"field_accuracy":"exact canonical ID/bool match","primary_score":"micro accuracy over 50 field decisions","fixture_exact_match":"all 5 fields correct","per_dimension_accuracy":"reported separately","no_post_freeze_tuning":true},"fixtures":[{"id":"S101","category":"domain_term_disambiguation","visible":{"prompt":"In a claims workflow, the term 'exposure' appears while allocating potential liability. A separate workplace note mentions sunlight exposure. Identify the claim-relevant semantic state.","facts":{"f1":"workflow=insurance_claims","f2":"claim exposure is being allocated for potential liability","f3":"workplace note mentions sunlight exposure"},"concepts":{"c_claim_exposure":"claim-level unit of potential liability","c_physical_exposure":"physical contact with an environmental factor","c_unresolved":"meaning cannot be resolved from the supplied context"},"relations":{"r1":"f2 GROUNDS c_claim_exposure","r2":"f3 GROUNDS c_physical_exposure","r3":"f1 DOES_NOT_DISAMBIGUATE exposure"},"goals":{"g1":"populate the claims semantic state","g2":"assess workplace safety"}},"oracle":{"primary_fact_id":"f2","semantic_concept_id":"c_claim_exposure","key_relation_id":"r1","ambiguity":"NO","goal_id":"g1"}},{"id":"S102","category":"near_miss_concept","visible":{"prompt":"A reserve estimate exists, but payment authorization has not been issued. A marketing note says the customer is premium. Identify the concept that controls whether payment may proceed.","facts":{"f1":"reserve_estimate=present","f2":"payment_authorization=absent","f3":"marketing_note=premium_customer"},"concepts":{"c_reserve":"estimated claim liability","c_authorization":"authority permitting payment","c_marketing":"customer marketing status"},"relations":{"r1":"f1 IS_EQUIVALENT_TO c_authorization","r2":"f2 CONTROLS payment_eligibility","r3":"f3 CONTROLS payment_eligibility"},"goals":{"g1":"determine payment eligibility","g2":"segment the customer"}},"oracle":{"primary_fact_id":"f2","semantic_concept_id":"c_authorization","key_relation_id":"r2","ambiguity":"NO","goal_id":"g1"}},{"id":"S103","category":"unresolved_ambiguity","visible":{"prompt":"The note says 'the owner approved it'. In this workflow, 'owner' can mean the policy owner or the task owner. No identifier or surrounding action resolves which one is meant.","facts":{"f1":"text=the owner approved it","f2":"owner may mean policy owner","f3":"owner may mean task owner"},"concepts":{"c_policy_owner":"person holding the policy","c_task_owner":"person assigned the workflow task","c_unresolved":"referent is unresolved"},"relations":{"r1":"f1 RESOLVES_TO c_policy_owner","r2":"f1 RESOLVES_TO c_task_owner","r3":"f1 INSUFFICIENT_TO_RESOLVE owner"},"goals":{"g1":"bind the owner referent correctly","g2":"continue without clarification"}},"oracle":{"primary_fact_id":"f1","semantic_concept_id":"c_unresolved","key_relation_id":"r3","ambiguity":"YES","goal_id":"g1"}},{"id":"S104","category":"causal_relation","visible":{"prompt":"A dashboard shows failures rise when traffic rises. A controlled intervention that changes only authorization routing makes the failures disappear. Identify the strongest causal semantic relation.","facts":{"f1":"traffic and failures are correlated","f2":"controlled authorization-routing intervention removes failures","f3":"UI color changed during the week"},"concepts":{"c_causal_auth":"authorization routing is causally implicated","c_correlation_only":"only correlation is established","c_ui_cause":"UI color causes failures"},"relations":{"r1":"f1 PROVES c_causal_auth","r2":"f2 SUPPORTS_CAUSAL c_causal_auth","r3":"f3 SUPPORTS_CAUSAL c_ui_cause"},"goals":{"g1":"identify the evidence-backed cause","g2":"redesign the UI"}},"oracle":{"primary_fact_id":"f2","semantic_concept_id":"c_causal_auth","key_relation_id":"r2","ambiguity":"NO","goal_id":"g1"}},{"id":"S105","category":"protected_intent_reframe","visible":{"prompt":"The current analysis models all payment failures as user error, but logs show a system-side authorization rejection that the variables cannot represent. Preserve the investigation goal while representing the observation.","facts":{"f1":"current_frame=user_error_only","f2":"log=system_authorization_rejection","f3":"proposal=change_goal_to_reduce_payouts"},"concepts":{"c_system_auth_failure":"system-side authorization failure","c_user_error":"user-caused failure","c_goal_change":"change the investigation objective"},"relations":{"r1":"f2 REQUIRES_REPRESENTATION c_system_auth_failure","r2":"f1 EXPLAINS f2","r3":"f3 PRESERVES investigation_goal"},"goals":{"g1":"explain the observed payment failure","g2":"minimize payouts"}},"oracle":{"primary_fact_id":"f2","semantic_concept_id":"c_system_auth_failure","key_relation_id":"r1","ambiguity":"NO","goal_id":"g1"}},{"id":"S106","category":"source_authority_conflict","visible":{"prompt":"A verified policy record says coverage is active. An unverified chat message says coverage is inactive. The source registry marks the verified policy record as current authority.","facts":{"f1":"verified_policy_record=coverage_active","f2":"unverified_chat=coverage_inactive","f3":"source_registry=f1_is_current_authority"},"concepts":{"c_active":"coverage is active under current authority","c_inactive":"coverage is inactive","c_unresolved":"authority conflict cannot be resolved"},"relations":{"r1":"f2 OVERRIDES f1","r2":"f3 AUTHORIZES f1_OVER_f2","r3":"f1 AND f2 ARE_EQUAL_AUTHORITY"},"goals":{"g1":"derive current authoritative coverage state","g2":"summarize all messages equally"}},"oracle":{"primary_fact_id":"f3","semantic_concept_id":"c_active","key_relation_id":"r2","ambiguity":"NO","goal_id":"g1"}},{"id":"S107","category":"domain_near_synonym","visible":{"prompt":"In claim handling, a reserve is set to estimate expected liability. No payment has been authorized or issued. Interpret 'reserve' for the semantic state.","facts":{"f1":"reserve=500000_yen","f2":"payment_authorization=absent","f3":"payment_issued=false"},"concepts":{"c_estimate":"estimated liability amount","c_payment":"money already authorized for payment","c_cash":"cash physically held"},"relations":{"r1":"f1 DENOTES c_estimate","r2":"f1 DENOTES c_payment","r3":"f3 MAKES f1 c_payment"},"goals":{"g1":"represent the claim financial state","g2":"confirm cash custody"}},"oracle":{"primary_fact_id":"f1","semantic_concept_id":"c_estimate","key_relation_id":"r1","ambiguity":"NO","goal_id":"g1"}},{"id":"S108","category":"mandatory_control_scope","visible":{"prompt":"Two investigation routes are evidence-supported and preserve a mandatory control. A third route is faster but bypasses that control. Identify the semantic constraint that must survive downstream reasoning.","facts":{"f1":"route_A=evidence_supported_and_control_preserving","f2":"route_B=evidence_supported_and_control_preserving","f3":"route_C=faster_but_bypasses_mandatory_control"},"concepts":{"c_control_constraint":"mandatory control is a protected constraint","c_speed_priority":"fastest route is the protected objective","c_single_route":"only one route may remain represented"},"relations":{"r1":"f3 VIOLATES c_control_constraint","r2":"f3 SATISFIES c_control_constraint","r3":"f1 INVALIDATES f2"},"goals":{"g1":"preserve evidence-compatible routes without violating controls","g2":"choose the fastest route immediately"}},"oracle":{"primary_fact_id":"f3","semantic_concept_id":"c_control_constraint","key_relation_id":"r1","ambiguity":"NO","goal_id":"g1"}},{"id":"S109","category":"negation_evidence","visible":{"prompt":"No evidence of fraud was found after review. An automated audit flag exists, but the flag is only a trigger for review and is not proof of fraud.","facts":{"f1":"review_found_no_fraud_evidence","f2":"automated_audit_flag=present","f3":"audit_flag_is_not_proof"},"concepts":{"c_no_fraud_evidence":"fraud is not supported by current evidence","c_fraud_confirmed":"fraud is confirmed","c_unresolved":"fraud status cannot be represented"},"relations":{"r1":"f2 PROVES c_fraud_confirmed","r2":"f3 BLOCKS_INFERENCE f2_TO_c_fraud_confirmed","r3":"f1 PROVES c_fraud_confirmed"},"goals":{"g1":"represent the evidence-supported fraud state","g2":"treat every alert as confirmed fraud"}},"oracle":{"primary_fact_id":"f1","semantic_concept_id":"c_no_fraud_evidence","key_relation_id":"r2","ambiguity":"NO","goal_id":"g1"}},{"id":"S110","category":"freshness_supersession","visible":{"prompt":"Yesterday an authoritative workflow record said APPROVED. Today the same authoritative source says REVOKED. An older copied chat still says APPROVED. Represent the current state.","facts":{"f1":"authoritative_record_yesterday=APPROVED","f2":"authoritative_record_today=REVOKED","f3":"copied_chat_old=APPROVED"},"concepts":{"c_approved":"current state approved","c_revoked":"current state revoked","c_conflict":"states must be treated as equally current"},"relations":{"r1":"f1 SUPERSEDES f2","r2":"f2 SUPERSEDES f1","r3":"f3 OVERRIDES f2"},"goals":{"g1":"represent the current authoritative workflow state","g2":"preserve the oldest state"}},"oracle":{"primary_fact_id":"f2","semantic_concept_id":"c_revoked","key_relation_id":"r2","ambiguity":"NO","goal_id":"g1"}}]}