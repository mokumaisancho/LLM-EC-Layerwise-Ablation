{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture_manifest.schema.json",
  "title": "Phase 1 Fixture Manifest",
  "type": "object",
  "required": ["protocol_version", "fixture_id", "fixture_generation", "status", "domain", "artifact_refs", "oracle_independence", "hashes"],
  "properties": {
    "protocol_version": {"const": "PHASE1_ARTIFACT_CONTRACT_V1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_generation": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEWED", "FROZEN", "RETIRED"]},
    "domain": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {
      "type": "object",
      "required": ["task", "s1_oracle", "s2_oracle", "s3_oracle", "s4_oracle"],
      "properties": {
        "task": {"type": "string"},
        "s1_oracle": {"type": "string"},
        "s2_oracle": {"type": "string"},
        "s3_oracle": {"type": "string"},
        "s4_oracle": {"type": "string"}
      },
      "additionalProperties": false
    },
    "oracle_independence": {
      "type": "object",
      "required": ["method", "reviewed_against_test_implementations"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "reviewed_against_test_implementations": {"const": false},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "required": ["task", "s1_oracle", "s2_oracle", "s3_oracle", "s4_oracle"],
      "additionalProperties": {"type": "string"}
    },
    "freeze": {
      "type": ["object", "null"],
      "properties": {
        "frozen_at": {"type": "string"},
        "freeze_commit": {"type": "string"},
        "scoring_version": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
